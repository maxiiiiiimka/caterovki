<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>КОТИРОВКА</title>
<style>
  body{margin:0;height:100vh;display:flex;flex-direction:column;background:#060A12;color:#EDE8DB;font-family:Arial,sans-serif;overflow:hidden}
  header{display:flex;justify-content:space-between;padding:16px 32px;border-bottom:1px solid #222;font-size:14px;letter-spacing:3px;color:#8a8577}
  main{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .label{color:#8a8577;letter-spacing:8px;font-size:14px;margin-bottom:12px}
  #value{font-size:20vh;font-weight:800;line-height:1}
  #delta{font-size:24px;margin-top:10px;color:#8a8577}
  .u{color:#35E08A}.d{color:#FF5252}
  .controls{display:flex;gap:14px;padding:20px 32px;height:26vh}
  button{flex:1;font-size:4vh;font-family:inherit;background:none;cursor:pointer;border:2px solid;letter-spacing:6px}
  #up{color:#35E08A;border-color:#35E08A}
  #down{color:#FF5252;border-color:#FF5252}
  #up:active{background:rgba(53,224,138,.2)}
  #down:active{background:rgba(255,82,82,.2)}
  #flash{position:fixed;inset:0;pointer-events:none;opacity:0;transition:opacity .4s}
</style>
</head>
<body>

<header><span>● КОТИРОВКА · LIVE</span><span id="clock">--:--</span></header>

<main>
  <div class="label">ТЕКУЩИЙ КУРС</div>
  <div id="value">100</div>
  <div id="delta">±0</div>
</main>

<div class="controls">
  <button id="up">▲ РОСТ</button>
  <button id="down">▼ ПАДЕНИЕ</button>
</div>

<div id="flash"></div>

<script>
var v = 100;

function move(dir){
  v = Math.max(0, v + dir);
  document.getElementById('value').textContent = v;
  var d = v - 100;
  var el = document.getElementById('delta');
  el.textContent = (d > 0 ? '+' : d < 0 ? '-' : '±') + Math.abs(d);
  el.className = d > 0 ? 'u' : d < 0 ? 'd' : '';
  var f = document.getElementById('flash');
  f.style.background = dir > 0 ? '#35E08A' : '#FF5252';
  f.style.opacity = .18;
  setTimeout(function(){ f.style.opacity = 0 }, 120);
  blip(dir);
}

var AC = null;
function blip(dir){
  try{
    AC = AC || new (window.AudioContext || window.webkitAudioContext)();
    var o = AC.createOscillator(), g = AC.createGain();
    o.frequency.value = dir > 0 ? 880 : 300;
    g.gain.setValueAtTime(.1, AC.currentTime);
    g.gain.exponentialRampToValueAtTime(.001, AC.currentTime + .12);
    o.connect(g); g.connect(AC.destination);
    o.start(); o.stop(AC.currentTime + .13);
  }catch(e){}
}

document.getElementById('up').onclick = function(){ move(1); };
document.getElementById('down').onclick = function(){ move(-1); };
document.onkeydown = function(e){
  if(e.key === 'ArrowUp'){ move(1); e.preventDefault(); }
  if(e.key === 'ArrowDown'){ move(-1); e.preventDefault(); }
};

setInterval(function(){
  document.getElementById('clock').textContent = new Date().toLocaleTimeString('ru-RU');
}, 1000);
</script>

</body>
</html>
