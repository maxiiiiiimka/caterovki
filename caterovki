<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>БИРЖА — котировки</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;800&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#060A12; --panel:#0B1220; --line:rgba(237,232,220,.1);
    --cream:#EDE8DB; --dim:rgba(237,232,220,.5);
    --up:#35E08A; --down:#FF5252; --accent:#FFB84D;
    --mono:'JetBrains Mono',monospace; --disp:'Unbounded',sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{
    background:var(--bg); color:var(--cream); font-family:var(--mono);
    display:flex; flex-direction:column; height:100vh; overflow:hidden;
    background-image:
      linear-gradient(rgba(237,232,220,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(237,232,220,.025) 1px, transparent 1px);
    background-size:48px 48px;
  }
  /* бегущая строка */
  .tape{background:var(--panel);border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap;height:34px;display:flex;align-items:center}
  .tape-track{display:inline-block;animation:tape 30s linear infinite;font-size:.8rem;letter-spacing:.08em}
  .tape-track b{font-weight:600}
  .tape .u{color:var(--up)} .tape .d{color:var(--down)}
  @keyframes tape{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  /* шапка */
  header{display:flex;align-items:center;gap:16px;padding:14px 28px;border-bottom:1px solid var(--line);flex-wrap:wrap}
  .brand{font-family:var(--disp);font-weight:800;font-size:1.05rem;letter-spacing:.06em}
  .brand[contenteditable]:focus{outline:1px dashed var(--accent);outline-offset:4px}
  .live{color:var(--up);font-family:var(--mono);font-size:.7rem;font-weight:600;animation:blink 1.6s infinite;margin-left:10px}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
  .clock{color:var(--dim);font-size:.9rem;letter-spacing:.1em}
  .controls{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .controls .lbl{font-size:.65rem;color:var(--dim);letter-spacing:.15em;margin-right:2px}
  .ctl{
    background:transparent;color:var(--cream);border:1px solid var(--line);
    font-family:var(--mono);font-size:.8rem;padding:7px 12px;cursor:pointer;
    transition:border-color .15s, background .15s, color .15s;letter-spacing:.05em;
  }
  .ctl:hover{border-color:var(--accent);color:var(--accent)}
  .ctl.on{background:var(--accent);border-color:var(--accent);color:#060A12;font-weight:800}
  /* табло */
  main{flex:1;display:flex;flex-direction:column;gap:10px;padding:18px 28px;min-height:0}
  .row{
    flex:1;min-height:0;display:grid;align-items:center;
    grid-template-columns:3.2rem minmax(0,1fr) auto 6.5rem auto;gap:20px;
    background:var(--panel);border:1px solid var(--line);border-left:5px solid transparent;
    padding:8px 26px;cursor:pointer;position:relative;
    transition:border-color .15s;
  }
  .row.sel{border-left-color:var(--accent);background:#0E1626}
  .row.flash-up{animation:fu .55s} .row.flash-down{animation:fd .55s}
  @keyframes fu{0%{background:rgba(53,224,138,.28)}100%{background:var(--panel)}}
  @keyframes fd{0%{background:rgba(255,82,82,.28)}100%{background:var(--panel)}}
  .num{font-size:1rem;color:var(--dim);font-weight:600}
  .row.sel .num{color:var(--accent)}
  .name{font-family:var(--disp);font-weight:500;font-size:clamp(1rem,2.6vh,1.7rem);letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .name[contenteditable="true"]{outline:1px dashed var(--accent);outline-offset:4px}
  .spark{display:block;margin-top:4px;opacity:.9}
  .val{font-weight:800;font-size:clamp(2.2rem,7.5vh,4.6rem);line-height:1;letter-spacing:-.02em;min-width:3ch;text-align:right;font-variant-numeric:tabular-nums}
  .val.bump{animation:bump .28s}
  @keyframes bump{0%{transform:scale(1.16)}100%{transform:scale(1)}}
  .delta{text-align:right;font-size:clamp(.85rem,2vh,1.15rem);font-weight:600}
  .delta.u{color:var(--up)} .delta.d{color:var(--down)} .delta.z{color:var(--dim)}
  .btns{display:flex;flex-direction:column;gap:8px}
  .arr{
    width:clamp(48px,7vh,64px);height:clamp(38px,5.2vh,52px);
    font-size:clamp(1.1rem,3vh,1.6rem);cursor:pointer;
    border:1px solid var(--line);background:transparent;color:var(--cream);
    transition:transform .1s, background .15s, border-color .15s;
  }
  .arr:hover{border-color:var(--cream)}
  .arr:active{transform:scale(.92)}
  .arr.up:hover{background:rgba(53,224,138,.15);border-color:var(--up);color:var(--up)}
  .arr.down:hover{background:rgba(255,82,82,.15);border-color:var(--down);color:var(--down)}
  .del{position:absolute;top:6px;right:8px;background:none;border:none;color:var(--dim);cursor:pointer;font-size:.85rem;opacity:0;transition:opacity .15s}
  .row:hover .del{opacity:.7}
  .del:hover{color:var(--down);opacity:1}
  /* подсказки */
  footer{border-top:1px solid var(--line);padding:9px 28px;display:flex;gap:26px;font-size:.7rem;color:var(--dim);letter-spacing:.08em;flex-wrap:wrap}
  footer b{color:var(--cream);font-weight:600}
  @media (max-width:700px){
    .row{grid-template-columns:2rem 1fr auto auto;gap:10px;padding:8px 14px}
    .delta{display:none}.spark{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .tape-track,.live{animation:none}
    .row.flash-up,.row.flash-down,.val.bump{animation:none}
  }
</style>
</head>
<body>

<div class="tape"><div class="tape-track" id="tape"></div></div>

<header>
  <div class="brand" id="title" contenteditable="true" spellcheck="false">БИРЖЕВАЯ ДОСКА</div>
  <span class="live">● LIVE</span>
  <div class="clock" id="clock">--:--:--</div>
  <div class="controls">
    <span class="lbl">ШАГ:</span>
    <button class="ctl step" data-s="1">×1</button>
    <button class="ctl step on" data-s="5">×5</button>
    <button class="ctl step" data-s="10">×10</button>
    <button class="ctl step" data-s="50">×50</button>
    <button class="ctl" id="addBtn" title="Добавить акцию">+ АКЦИЯ</button>
    <button class="ctl" id="resetBtn" title="Сброс к старту (R)">⟲ СБРОС</button>
    <button class="ctl" id="soundBtn" title="Звук">🔊</button>
    <button class="ctl" id="fsBtn" title="Полный экран (F)">⛶</button>
  </div>
</header>

<main id="board"></main>

<footer>
  <span><b>1–9</b> — выбор акции</span>
  <span><b>↑ ↓</b> — изменить (можно зажать)</span>
  <span><b>dbl-клик</b> — переименовать</span>
  <span><b>R</b> — сброс</span>
  <span><b>F</b> — полный экран</span>
</footer>

<script>
const KEY='orbita-board-v1';
let stocks=[
  {name:'ЗАРЯ',val:100,base:100,hist:[100]},
  {name:'ИМПУЛЬС',val:100,base:100,hist:[100]},
  {name:'РЕАКТОР',val:100,base:100,hist:[100]},
  {name:'АНТЕННА',val:100,base:100,hist:[100]},
  {name:'ВОСТОК',val:100,base:100,hist:[100]},
  {name:'ГИРОСКОП',val:100,base:100,hist:[100]}
];
let sel=0, step=5, soundOn=true, editing=false;

/* сохранение */
function save(){ try{localStorage.setItem(KEY,JSON.stringify({stocks,step,title:document.getElementById('title').textContent}))}catch(e){} }
function load(){
  try{
    const d=JSON.parse(localStorage.getItem(KEY));
    if(d && Array.isArray(d.stocks) && d.stocks.length){ stocks=d.stocks; step=d.step||5; if(d.title) document.getElementById('title').textContent=d.title; }
  }catch(e){}
}

/* звук */
let AC=null;
function blip(dir){
  if(!soundOn) return;
  try{
    AC=AC||new (window.AudioContext||window.webkitAudioContext)();
    const o=AC.createOscillator(), g=AC.createGain();
    o.type='sine'; o.frequency.setValueAtTime(dir>0?560:420,AC.currentTime);
    o.frequency.exponentialRampToValueAtTime(dir>0?880:280,AC.currentTime+.09);
    g.gain.setValueAtTime(.12,AC.currentTime);
    g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+.12);
    o.connect(g).connect(AC.destination); o.start(); o.stop(AC.currentTime+.13);
  }catch(e){}
}

/* спарклайн */
function sparkSVG(hist){
  const w=170,h=30,n=hist.length,max=Math.max(...hist),min=Math.min(...hist),r=(max-min)||1;
  const pts=hist.map((v,i)=>{
    const x=n>1? i/(n-1)*w : w/2;
    const y=h-4-((v-min)/r)*(h-8);
    return x.toFixed(1)+','+y.toFixed(1);
  }).join(' ');
  const col=hist[n-1]>=hist[0]?'var(--up)':'var(--down)';
  return `<svg class="spark" width="${w}" height="${h}"><polyline points="${pts}" fill="none" stroke="${col}" stroke-width="2"/></svg>`;
}

/* рендер */
function render(){
  const b=document.getElementById('board');
  b.innerHTML='';
  stocks.forEach((s,i)=>{
    const d=s.val-s.base;
    const row=document.createElement('div');
    row.className='row'+(i===sel?' sel':'');
    row.dataset.i=i;
    row.innerHTML=`
      <div class="num">${String(i+1).padStart(2,'0')}</div>
      <div class="info">
        <div class="name" spellcheck="false">${s.name}</div>
        ${sparkSVG(s.hist)}
      </div>
      <div class="val">${s.val}</div>
      <div class="delta ${d>0?'u':d<0?'d':'z'}">${d>0?'+':''}${d}</div>
      <div class="btns">
        <button class="arr up" title="Повысить">▲</button>
        <button class="arr down" title="Понизить">▼</button>
      </div>
      <button class="del" title="Удалить">✕</button>`;
    row.addEventListener('click',e=>{ if(e.target.closest('.arr')||e.target.closest('.del')||editing)return; sel=i; refreshSel(); });
    row.querySelector('.up').addEventListener('click',e=>{e.stopPropagation();sel=i;refreshSel();change(i,+step);});
    row.querySelector('.down').addEventListener('click',e=>{e.stopPropagation();sel=i;refreshSel();change(i,-step);});
    row.querySelector('.del').addEventListener('click',e=>{
      e.stopPropagation();
      if(stocks.length<=1)return;
      stocks.splice(i,1); if(sel>=stocks.length)sel=stocks.length-1;
      render(); save();
    });
    const nm=row.querySelector('.name');
    nm.addEventListener('dblclick',e=>{
      e.stopPropagation(); editing=true;
      nm.contentEditable='true'; nm.focus();
      const r=document.createRange(); r.selectNodeContents(nm);
      const s0=window.getSelection(); s0.removeAllRanges(); s0.addRange(r);
    });
    nm.addEventListener('keydown',e=>{ if(e.key==='Enter'){e.preventDefault();nm.blur();} e.stopPropagation(); });
    nm.addEventListener('blur',()=>{
      nm.contentEditable='false'; editing=false;
      stocks[i].name=nm.textContent.trim()||'АКЦИЯ'; nm.textContent=stocks[i].name;
      save(); tape();
    });
    b.appendChild(row);
  });
  tape();
}
function refreshSel(){
  document.querySelectorAll('.row').forEach(r=>r.classList.toggle('sel',+r.dataset.i===sel));
}

/* изменение котировки */
function change(i,d){
  const s=stocks[i];
  const nv=Math.max(0,s.val+d);
  if(nv===s.val)return;
  s.val=nv;
  s.hist.push(nv); if(s.hist.length>40)s.hist.shift();
  const row=document.querySelector(`.row[data-i="${i}"]`);
  const val=row.querySelector('.val');
  val.textContent=s.val;
  val.classList.remove('bump'); void val.offsetWidth; val.classList.add('bump');
  const dd=s.val-s.base;
  const delta=row.querySelector('.delta');
  delta.textContent=(dd>0?'+':'')+dd;
  delta.className='delta '+(dd>0?'u':dd<0?'d':'z');
  row.querySelector('.spark').outerHTML=sparkSVG(s.hist);
  row.classList.remove('flash-up','flash-down'); void row.offsetWidth;
  row.classList.add(d>0?'flash-up':'flash-down');
  blip(d); save(); tape();
}

/* бегущая строка */
function tape(){
  const txt=stocks.map(s=>{
    const d=s.val-s.base;
    const cls=d>0?'u':d<0?'d':'';
    const arrow=d>0?'▲':d<0?'▼':'◆';
    return `<b>${s.name}</b> ${s.val} <span class="${cls}">${arrow} ${d>0?'+':''}${d}</span>`;
  }).join('&nbsp;&nbsp;•&nbsp;&nbsp;')+'&nbsp;&nbsp;•&nbsp;&nbsp;';
  document.getElementById('tape').innerHTML=`<span>${txt}</span><span>${txt}</span>`;
}

/* клавиатура */
document.addEventListener('keydown',e=>{
  if(editing)return;
  if(e.key>='1'&&e.key<='9'){ const i=+e.key-1; if(i<stocks.length){sel=i;refreshSel();} }
  else if(e.key==='ArrowUp'){ e.preventDefault(); change(sel,+step); }
  else if(e.key==='ArrowDown'){ e.preventDefault(); change(sel,-step); }
  else if(e.key.toLowerCase()==='r'||e.key.toLowerCase()==='к'){ resetAll(); }
  else if(e.key.toLowerCase()==='f'||e.key.toLowerCase()==='а'){ toggleFS(); }
});

function resetAll(){
  stocks.forEach(s=>{s.val=s.base;s.hist=[s.base];});
  render(); save();
}
function toggleFS(){
  if(!document.fullscreenElement) document.documentElement.requestFullscreen().catch(()=>{});
  else document.exitFullscreen();
}

/* контролы */
document.querySelectorAll('.step').forEach(b=>b.addEventListener('click',()=>{
  step=+b.dataset.s;
  document.querySelectorAll('.step').forEach(x=>x.classList.toggle('on',x===b));
  save();
}));
document.getElementById('resetBtn').addEventListener('click',resetAll);
document.getElementById('fsBtn').addEventListener('click',toggleFS);
document.getElementById('addBtn').addEventListener('click',()=>{
  if(stocks.length>=9)return;
  stocks.push({name:'НОВАЯ АКЦИЯ',val:100,base:100,hist:[100]});
  sel=stocks.length-1; render(); save();
});
document.getElementById('soundBtn').addEventListener('click',e=>{
  soundOn=!soundOn; e.currentTarget.textContent=soundOn?'🔊':'🔇';
});

/* часы */
function tick(){
  document.getElementById('clock').textContent=new Date().toLocaleTimeString('ru-RU');
}
setInterval(tick,1000); tick();

/* старт */
load();
document.querySelectorAll('.step').forEach(x=>x.classList.toggle('on',+x.dataset.s===step));
render();
</script>
</body>
</html>
